<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>DGSteam</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169;CS0414;CS0168</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Steam/src/**/*.cs" />
    <Compile Include="../../Steam/Properties/AssemblyInfo.cs" />
    <Reference Include="../../Steam/Steamworks.NET.dll" />
  </ItemGroup>
</Project>
